<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Tugas 1 - Menghitung Luas Bangun Datar</title>
</head>
<body>

    <h1>Hasil Perhitungan Luas</h1>
    <div id="output"></div>

    <script>
        // 1. Menghitung Luas Persegi Panjang
        // Rumus: panjang * lebar
        let panjangPP = 10;
        let lebarPP = 5;
        let luasPersegiPanjang = panjangPP * lebarPP; // Menggunakan operator perkalian (*)
        console.log("Luas Persegi Panjang: " + luasPersegiPanjang);

        // 2. Menghitung Luas Bujur Sangkar (Persegi)
        // Rumus: sisi * sisi
        let sisi = 7;
        let luasBujurSangkar = sisi * sisi;
        console.log("Luas Bujur Sangkar: " + luasBujurSangkar);

        // 3. Menghitung Luas Segitiga
        // Rumus: 0.5 * alas * tinggi
        let alas = 8;
        let tinggi = 12;
        let luasSegitiga = 0.5 * alas * tinggi;
        console.log("Luas Segitiga: " + luasSegitiga);

        // Menampilkan hasil ke halaman HTML agar mentor mudah melihat
        document.getElementById("output").innerHTML = `
            <p>Luas Persegi Panjang (10x5): ${luasPersegiPanjang}</p>
            <p>Luas Bujur Sangkar (sisi 7): ${luasBujurSangkar}</p>
            <p>Luas Segitiga (alas 8, tinggi 12): ${luasSegitiga}</p>
        `;
    </script>
</body>
</html>
